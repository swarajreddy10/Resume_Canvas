{
  "name": "ResumeCanvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun eslint . --ext .ts,.tsx --fix",
    "lint:check": "bun eslint . --max-warnings=0",
    "format": "bun prettier --write . --config config/.prettierrc",
    "format:check": "bun prettier --check . --config config/.prettierrc",
    "type-check": "bun tsc --noEmit",
    "db:sync-indexes": "bun scripts/sync-indexes.ts",
    "db:migrate-slugs": "bun scripts/migrate-legacy-slugs.ts",
    "test": "bun test tests/unit",
    "test:watch": "bun test --watch tests/unit",
    "test:coverage": "bun test tests/unit --coverage",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "playwright test --config=config/playwright.config.ts",
    "test:e2e:browsers": "playwright install --with-deps chromium && puppeteer browsers install chrome",
    "prepare": "husky",
    "verify": "bun run format && bun run lint && bun run type-check"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.91.3",
    "@types/puppeteer": "^7.0.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "groq-sdk": "~1.1.1",
    "immer": "~11.1.4",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.1.0",
    "mongoose": "~9.3.1",
    "motion": "^12.38.0",
    "next": "16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "puppeteer": "^24.40.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "resend": "^6.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "~5.0.12"
  },
  "overrides": {
    "minimatch": "^3.1.3",
    "flatted": "^3.4.0",
    "basic-ftp": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "~25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "~8.57.1",
    "@typescript-eslint/parser": "~8.57.1",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.9",
    "bun-types": "^1.3.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-react-hooks": "~7.0.1",
    "husky": "~9.1.7",
    "lint-staged": "~16.4.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "~3.8.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
