exports[`resume templates tech renders its sample résumé 1`] = `"<div style="background:#fff;box-sizing:border-box;color:#374151;font-family:&#x27;Inter&#x27;, &#x27;Helvetica Neue&#x27;, Arial, sans-serif;font-size:12px;line-height:1.5;min-height:1123px;padding:48px 52px;width:794px"><div style="align-items:flex-start;display:flex;gap:20px;margin-bottom:10px"><div style="flex:1"><h1 style="color:#1d4ed8;font-size:36px;font-weight:900;letter-spacing:-0.02em;line-height:1.05;margin:0 0 4px">Arjun Sharma</h1><div style="color:#64748b;font-size:14px;font-weight:500;margin-bottom:8px">Senior Software Development Engineer</div><div style="align-items:center;color:#64748b;display:flex;flex-wrap:wrap;font-size:11px;gap:0"><span style="align-items:center;display:flex"><span>arjun.sharma@email.com</span></span><span style="align-items:center;display:flex"><span style="color:#94a3b8;margin:0 6px">•</span><span>+1 (415) 234-5678</span></span><span style="align-items:center;display:flex"><span style="color:#94a3b8;margin:0 6px">•</span><span>Seattle, WA</span></span><span style="align-items:center;display:flex"><span style="color:#94a3b8;margin:0 6px">•</span><span>linkedin.com/in/arjunsharma</span></span><span style="align-items:center;display:flex"><span style="color:#94a3b8;margin:0 6px">•</span><span>github.com/arjunsharma</span></span></div></div><div style="align-items:center;background:#dbeafe;border-radius:50%;color:#2563eb;display:flex;flex-shrink:0;font-size:18px;font-weight:700;height:56px;justify-content:center;width:56px">AS</div></div><div style="background:#2563eb;height:2px;margin-bottom:20px"></div><div style="margin-bottom:20px"><div style="margin-bottom:12px"><div style="align-items:center;display:flex;gap:10px"><span style="color:#2563eb;font-size:10.5px;font-weight:900;letter-spacing:0.18em;text-transform:uppercase">Summary</span></div><div style="background:#2563eb;height:1.5px;margin-top:4px"></div></div><p style="color:#374151;font-size:12px;line-height:1.65;margin:0">Full-stack software engineer with 6+ years delivering scalable cloud-native solutions. Expert in React, Node.js, and AWS with a track record of leading high-impact platform migrations and mentoring engineering teams.</p></div><div style="margin-bottom:20px"><div style="margin-bottom:12px"><div style="align-items:center;display:flex;gap:10px"><span style="color:#2563eb;font-size:10.5px;font-weight:900;letter-spacing:0.18em;text-transform:uppercase">Professional Experience</span></div><div style="background:#2563eb;height:1.5px;margin-top:4px"></div></div><div style="margin-bottom:16px"><div style="align-items:baseline;display:flex;justify-content:space-between;margin-bottom:1px"><span style="color:#0f172a;font-size:13px;font-weight:800">Senior Software Development Engineer</span><span style="color:#64748b;font-size:11px;font-style:italic;margin-left:8px;white-space:nowrap">Mar 2021 – Present</span></div><div style="color:#2563eb;font-size:11.5px;font-weight:700;margin-bottom:5px">Amazon Web Services, Seattle, WA</div><p style="color:#374151;font-size:11px;font-style:italic;line-height:1.55;margin:0 0 4px">Architected microservices platform handling 50M+ daily API requests with 99.99% uptime across three global regions.</p><ul style="list-style:none;margin:0;padding:0"><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Led migration from monolithic to serverless architecture on AWS Lambda, reducing infrastructure costs by 45% and improving p99 latency by 38%</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Designed and shipped a distributed tracing system integrating OpenTelemetry with X-Ray, cutting mean time to detection for incidents from 42 min to 8 min</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Mentored 5 mid-level engineers through bi-weekly code reviews and architecture walkthroughs, improving team code quality score by 60%</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Drove adoption of automated load testing in CI/CD pipelines, eliminating 3 production outages in Q3 2022 and Q1 2023</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Collaborated with product and security teams to achieve SOC 2 Type II compliance for the platform within an 8-month timeline</span></li></ul></div><div style="margin-bottom:0"><div style="align-items:baseline;display:flex;justify-content:space-between;margin-bottom:1px"><span style="color:#0f172a;font-size:13px;font-weight:800">Software Engineer II</span><span style="color:#64748b;font-size:11px;font-style:italic;margin-left:8px;white-space:nowrap">Jun 2019 – Feb 2021</span></div><div style="color:#2563eb;font-size:11.5px;font-weight:700;margin-bottom:5px">Microsoft, Redmond, WA</div><p style="color:#374151;font-size:11px;font-style:italic;line-height:1.55;margin:0 0 4px">Owned Azure DevOps CI/CD pipeline experiences for enterprise customers with 5k+ active organizations.</p><ul style="list-style:none;margin:0;padding:0"><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Re-architected the YAML pipeline editor with React and Monaco Editor, improving developer satisfaction scores from 62% to 89%</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Built an intelligent task recommendation engine using collaborative filtering, increasing average pipeline task reuse by 30%</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Delivered a self-service automation toolkit adopted by 500+ internal engineering teams within 60 days of launch</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:7px;line-height:1.55;margin-bottom:3px"><span style="color:#2563eb;flex-shrink:0;font-weight:700;margin-top:1px">›</span><span>Reduced API response time for the pipeline run dashboard by 55% through query optimization and Redis caching</span></li></ul></div></div><div style="margin-bottom:20px"><div style="margin-bottom:12px"><div style="align-items:center;display:flex;gap:10px"><span style="color:#2563eb;font-size:10.5px;font-weight:900;letter-spacing:0.18em;text-transform:uppercase">Education</span></div><div style="background:#2563eb;height:1.5px;margin-top:4px"></div></div><div style="margin-bottom:0"><div style="align-items:baseline;display:flex;justify-content:space-between"><span style="color:#0f172a;font-size:13px;font-weight:800">Bachelor of Science in Computer Science</span><span style="color:#64748b;font-size:11px;font-style:italic;margin-left:8px;white-space:nowrap">2015 – 2019</span></div><div style="color:#2563eb;font-size:11.5px;font-weight:700">Stanford University, Stanford, CA | GPA: 3.9</div></div></div><div style="margin-bottom:20px"><div style="margin-bottom:12px"><div style="align-items:center;display:flex;gap:10px"><span style="color:#2563eb;font-size:10.5px;font-weight:900;letter-spacing:0.18em;text-transform:uppercase">Technical Skills</span></div><div style="background:#2563eb;height:1.5px;margin-top:4px"></div></div><div style="display:flex;flex-wrap:wrap;gap:6px"><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">JavaScript</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">TypeScript</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">React</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">Node.js</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">Python</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">AWS</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">Docker</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">Kubernetes</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">PostgreSQL</span><span style="background:#eff6ff;border-radius:4px;border:1px solid #bfdbfe;color:#1d4ed8;font-size:11px;font-weight:600;padding:3px 10px">MongoDB</span></div></div><div style="margin-bottom:20px"><div style="margin-bottom:12px"><div style="align-items:center;display:flex;gap:10px"><span style="color:#2563eb;font-size:10.5px;font-weight:900;letter-spacing:0.18em;text-transform:uppercase">Projects</span></div><div style="background:#2563eb;height:1.5px;margin-top:4px"></div></div><div style="margin-bottom:0"><span style="color:#0f172a;font-size:13px;font-weight:800">React Query Contributor</span><p style="color:#374151;font-size:11.5px;line-height:1.55;margin:3px 0">Core contributor to React Query library with 35K+ stars.</p><div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px"><span style="background:#eff6ff;border-radius:3px;color:#1d4ed8;font-size:10px;font-weight:600;padding:1px 6px">TypeScript</span><span style="background:#eff6ff;border-radius:3px;color:#1d4ed8;font-size:10px;font-weight:600;padding:1px 6px">React</span><span style="background:#eff6ff;border-radius:3px;color:#1d4ed8;font-size:10px;font-weight:600;padding:1px 6px">Testing Library</span></div></div></div><div><div style="margin-bottom:12px"><div style="align-items:center;display:flex;gap:10px"><span style="color:#2563eb;font-size:10.5px;font-weight:900;letter-spacing:0.18em;text-transform:uppercase">Certifications</span></div><div style="background:#2563eb;height:1.5px;margin-top:4px"></div></div><div style="align-items:baseline;display:flex;justify-content:space-between;margin-bottom:5px"><div><span style="color:#0f172a;font-size:12px;font-weight:700">AWS Certified Solutions Architect – Professional</span><span style="color:#64748b;font-size:11px;margin-left:6px">— Amazon Web Services</span></div><span style="color:#64748b;font-size:11px;font-style:italic;margin-left:8px;white-space:nowrap">2023</span></div><div style="align-items:baseline;display:flex;justify-content:space-between;margin-bottom:5px"><div><span style="color:#0f172a;font-size:12px;font-weight:700">Certified Kubernetes Administrator (CKA)</span><span style="color:#64748b;font-size:11px;margin-left:6px">— CNCF</span></div><span style="color:#64748b;font-size:11px;font-style:italic;margin-left:8px;white-space:nowrap">2022</span></div></div></div>"`;

