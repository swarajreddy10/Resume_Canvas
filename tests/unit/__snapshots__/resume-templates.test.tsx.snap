exports[`resume templates executive renders its sample résumé 1`] = `"<div style="background:#fff;display:flex;font-family:&#x27;Inter&#x27;, &#x27;Helvetica Neue&#x27;, Arial, sans-serif;font-size:12px;min-height:1123px;width:794px"><div style="background:#1b4332;box-sizing:border-box;color:#fff;flex-shrink:0;min-height:1123px;padding:40px 24px;width:240px"><div style="align-items:center;background:rgba(74,222,128,0.15);border-radius:50%;border:2px solid #4ade80;color:#4ade80;display:flex;font-size:22px;font-weight:700;height:72px;justify-content:center;margin-bottom:14px;width:72px">MA</div><div style="color:#fff;font-size:18px;font-weight:900;line-height:1.2;margin-bottom:6px">Michael Anderson</div><div style="color:#86efac;font-size:10px;line-height:1.4;margin-bottom:20px">Vice President of Engineering</div><div style="background:#2d6a4f;height:1px;margin-bottom:20px"></div><div style="margin-bottom:24px"><div style="color:#4ade80;font-size:9px;font-weight:800;letter-spacing:0.2em;margin-bottom:10px;text-transform:uppercase">Details</div><div style="color:#d1fae5;font-size:10px;line-height:1.45;margin-bottom:5px;word-break:break-all">New York, NY</div><div style="color:#d1fae5;font-size:10px;line-height:1.45;margin-bottom:5px;word-break:break-all">michael.anderson@email.com</div><div style="color:#d1fae5;font-size:10px;line-height:1.45;margin-bottom:5px;word-break:break-all">+1 (212) 555-0199</div><div style="color:#d1fae5;font-size:10px;line-height:1.45;margin-bottom:5px;word-break:break-all">linkedin.com/in/manderson</div></div><div style="margin-bottom:24px"><div style="color:#4ade80;font-size:9px;font-weight:800;letter-spacing:0.2em;margin-bottom:10px;text-transform:uppercase">Expertise</div><div style="margin-bottom:8px"><div style="color:#ecfdf5;font-size:10.5px;margin-bottom:3px">Engineering Leadership</div><div style="background:#2d6a4f;border-radius:2px;height:3px;overflow:hidden"><div style="background:#4ade80;border-radius:2px;height:100%;width:92%"></div></div></div><div style="margin-bottom:8px"><div style="color:#ecfdf5;font-size:10.5px;margin-bottom:3px">Strategic Planning</div><div style="background:#2d6a4f;border-radius:2px;height:3px;overflow:hidden"><div style="background:#4ade80;border-radius:2px;height:100%;width:85%"></div></div></div><div style="margin-bottom:8px"><div style="color:#ecfdf5;font-size:10.5px;margin-bottom:3px">Cloud Architecture</div><div style="background:#2d6a4f;border-radius:2px;height:3px;overflow:hidden"><div style="background:#4ade80;border-radius:2px;height:100%;width:88%"></div></div></div><div style="margin-bottom:8px"><div style="color:#ecfdf5;font-size:10.5px;margin-bottom:3px">Agile Transformation</div><div style="background:#2d6a4f;border-radius:2px;height:3px;overflow:hidden"><div style="background:#4ade80;border-radius:2px;height:100%;width:78%"></div></div></div><div style="margin-bottom:8px"><div style="color:#ecfdf5;font-size:10.5px;margin-bottom:3px">Stakeholder Management</div><div style="background:#2d6a4f;border-radius:2px;height:3px;overflow:hidden"><div style="background:#4ade80;border-radius:2px;height:100%;width:90%"></div></div></div><div style="margin-bottom:8px"><div style="color:#ecfdf5;font-size:10.5px;margin-bottom:3px">Organizational Design</div><div style="background:#2d6a4f;border-radius:2px;height:3px;overflow:hidden"><div style="background:#4ade80;border-radius:2px;height:100%;width:82%"></div></div></div></div><div style="margin-bottom:24px"><div style="color:#4ade80;font-size:9px;font-weight:800;letter-spacing:0.2em;margin-bottom:10px;text-transform:uppercase">Education</div><div style="margin-bottom:12px"><div style="color:#ecfdf5;font-size:10.5px;font-weight:700;line-height:1.35">MBA</div><div style="color:#86efac;font-size:10px;line-height:1.35">Technology &amp; Operations Management</div><div style="color:#d1fae5;font-size:10px;line-height:1.35">MIT Sloan School of Management</div><div style="color:#6ee7b7;font-size:9.5px;line-height:1.35;margin-top:1px">2014 – 2016</div></div><div style="margin-bottom:12px"><div style="color:#ecfdf5;font-size:10.5px;font-weight:700;line-height:1.35">Bachelor of Science</div><div style="color:#86efac;font-size:10px;line-height:1.35">Computer Science</div><div style="color:#d1fae5;font-size:10px;line-height:1.35">Carnegie Mellon University</div><div style="color:#6ee7b7;font-size:9.5px;line-height:1.35;margin-top:1px">2005 – 2009 · GPA 3.8</div></div></div><div><div style="color:#4ade80;font-size:9px;font-weight:800;letter-spacing:0.2em;margin-bottom:10px;text-transform:uppercase">Certifications</div><div style="margin-bottom:10px"><div style="color:#ecfdf5;font-size:10px;font-weight:700;line-height:1.4">Certified Scrum Master (CSM)</div><div style="color:#6ee7b7;font-size:9.5px">Scrum Alliance · 2018</div></div><div style="margin-bottom:10px"><div style="color:#ecfdf5;font-size:10px;font-weight:700;line-height:1.4">AWS Certified Solutions Architect</div><div style="color:#6ee7b7;font-size:9.5px">Amazon Web Services · 2020</div></div></div></div><div style="background:#fff;box-sizing:border-box;flex:1;padding:40px 36px"><div style="margin-bottom:24px"><div style="margin-bottom:12px"><span style="color:#1b4332;font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase">Profile</span><div style="background:#1b4332;height:1.5px;margin-top:4px"></div></div><p style="color:#374151;font-size:11.5px;line-height:1.7;margin:0">Strategic technology executive with 15+ years leading high-performing engineering organizations at scale. Proven track record driving digital transformation, building world-class teams, and delivering platforms that generate measurable business impact.</p></div><div style="margin-bottom:24px"><div style="margin-bottom:12px"><span style="color:#1b4332;font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase">Employment History</span><div style="background:#1b4332;height:1.5px;margin-top:4px"></div></div><div style="margin-bottom:20px"><div style="align-items:flex-start;display:flex;justify-content:space-between;margin-bottom:2px"><span style="color:#0f172a;font-size:13.5px;font-weight:800;line-height:1.2">Vice President of Engineering</span><span style="color:#64748b;font-size:10.5px;font-style:italic;margin-left:10px;margin-top:2px;white-space:nowrap">Jan 2020 – Present</span></div><div style="color:#1b4332;font-size:12px;font-weight:700;margin-bottom:6px">Goldman Sachs · New York, NY</div><p style="color:#4b5563;font-size:11px;font-style:italic;line-height:1.6;margin:0 0 6px">Lead engineering organization of 120+ across equities, fixed income, and risk platforms serving $2B+ daily trading volume.</p><ul style="list-style:none;margin:0;padding:0"><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Directed full migration of legacy on-premise trading infrastructure to AWS, delivering $18M in annual cost savings and reducing deployment time from 3 weeks to under 2 hours</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Built and scaled engineering organization from 65 to 120 engineers across 8 teams while maintaining 95% retention through structured career laddering and mentorship programs</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Reduced production incidents by 75% by institutionalizing SRE practices, blameless post-mortems, and a firm-wide engineering excellence program</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Partnered with Chief Risk Officer to deliver real-time risk analytics platform processing 4M events/sec, enabling traders to act on market signals 60% faster</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Established quarterly OKR process aligning 8 engineering teams to $40M annual technology roadmap with 92% on-time delivery rate</span></li></ul></div><div style="margin-bottom:0"><div style="align-items:flex-start;display:flex;justify-content:space-between;margin-bottom:2px"><span style="color:#0f172a;font-size:13.5px;font-weight:800;line-height:1.2">Senior Engineering Manager</span><span style="color:#64748b;font-size:10.5px;font-style:italic;margin-left:10px;margin-top:2px;white-space:nowrap">Mar 2016 – Dec 2019</span></div><div style="color:#1b4332;font-size:12px;font-weight:700;margin-bottom:6px">JPMorgan Chase · New York, NY</div><p style="color:#4b5563;font-size:11px;font-style:italic;line-height:1.6;margin:0 0 6px">Oversaw mobile banking platform serving 5M+ customers with daily release cadence and 99.95% availability SLA.</p><ul style="list-style:none;margin:0;padding:0"><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Introduced DevOps practices and trunk-based development, increasing deployment frequency from bi-weekly to daily with zero increase in incident rate</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Partnered with Product and Design on $15M multi-year roadmap; delivered 14 of 14 major features on schedule across three annual planning cycles</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Grew team from 12 to 35 engineers; implemented structured technical interviewing that reduced mis-hire rate from 22% to 4%</span></li><li style="color:#374151;display:flex;font-size:11.5px;gap:8px;line-height:1.6;margin-bottom:4px"><span style="color:#1b4332;flex-shrink:0;font-weight:700;margin-top:1px">•</span><span>Championed accessibility initiative bringing mobile app to WCAG 2.1 AA compliance, expanding addressable user base by an estimated 400K users</span></li></ul></div></div><div style="margin-top:auto;padding-top:8px"><p style="color:#64748b;font-size:11px;font-style:italic;margin:0">References available upon request.</p></div></div></div>"`;

